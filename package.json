{
  "name": "virexo-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Virexo Real-Time Chat Application Monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "lint": "npx --no-install eslint .",
    "lint:fix": "npx --no-install eslint . --fix",
    "format": "npx prettier --write .",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm test -w apps/api",
    "test:web": "npm test -w apps/web",
    "test:e2e": "npx playwright test",
    "test:ci": "npm run test:api && npm run test:web && npm run build -w apps/web",
    "deploy:firebase": "npm run build -w apps/web && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^15.30.2",
    "globals": "^15.15.0",
    "prettier": "^3.5.1"
  }
}
