# Root Monorepo Environment Variables
PORT=5000
VITE_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# JWT Secrets (change in production)
# JWT_ACCESS_SECRET=your_access_secret_here
# JWT_REFRESH_SECRET=your_refresh_secret_here

# MongoDB
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/virexo

# Email Configuration
# Provider: "console" (default, logs to terminal) or "brevo" (production)
EMAIL_PROVIDER=console
# BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM_NAME=Virexo
EMAIL_FROM_ADDRESS=noreply@virexo.app
